# Configure the verified production domain before enabling indexing.
NEXT_PUBLIC_SITE_URL=
# Optional on Vercel production: defaults to https://neramit-lifting.com and indexable.
# Set SITE_INDEXABLE=false to switch indexing off.
SITE_INDEXABLE=

# Quote/contact form email delivery (Resend). Required for the form to send.
RESEND_API_KEY=
# Optional: override the inbox (comma-separated) and the sender.
INQUIRY_TO_EMAIL=
RESEND_FROM=
